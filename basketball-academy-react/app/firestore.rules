rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // users: a person can read/create their own doc (signup).
    // Only admins can update statut/role/dateDernierPaiement, or delete players.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == 'client'
                    && request.resource.data.statut == 'En attente';
      allow update: if isAdmin() ||
                    (isSignedIn() && request.auth.uid == userId
                      && request.resource.data.role == resource.data.role
                      && request.resource.data.statut == resource.data.statut);
      allow delete: if isAdmin();
    }

    // messages: anyone can send a contact message; only admins can read/delete.
    match /messages/{msgId} {
      allow create: if true;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
